# Application
NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/exchange-reader

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Encryption (CRITICAL: Use strong key in production, minimum 32 characters)
ENCRYPTION_MASTER_KEY=your-super-secret-master-key-min-32-characters-long

# Binance Configuration (optional)
# Use 'binance.us' for US users, default is 'binance.com'
# BINANCE_HOSTNAME=binance.com
# BINANCE_STREAM_HOST=stream.binance.com

# Passkeys / WebAuthn
#
# PASSKEY_RP_ID es el dominio que firma las credenciales. Tiene que ser un
# dominio PÚBLICO que sirva /.well-known/apple-app-site-association, porque
# quien valida la asociación es el CDN de Apple, no el teléfono: un host que
# sólo existe dentro de la tailnet no sirve, y dejar 'localhost' en producción
# hace fallar el registro con "Domain not associated".
#
# PASSKEY_ORIGIN es la lista de origins autorizados, separados por coma. Cada
# cliente manda el suyo (la app iOS el dominio de sus associated domains, la
# webapp el dominio donde está publicada) y todos deben ser el rpId o un
# subdominio suyo.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000
